# Local development can keep using the JSON/file fallback by omitting these.
# Production should use Azure Database for PostgreSQL for consent metadata.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/consentdb?sslmode=require"

# Production should use private Azure Blob Storage for PDFs, signatures, and thumbprints.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="consent-files"

DEMO_USER_EMAIL="collector@10x.local"
DEMO_USER_PASSWORD="change-this-admin-password"
RICHBLACK_USER_EMAIL="richblack@10x.local"
RICHBLACK_USER_PASSWORD="change-this-richblack-password"
BUSALA_USER_EMAIL="busala@10x.local"
BUSALA_USER_PASSWORD="change-this-busala-password"
UNCDF_USER_EMAIL="uncdf@10x.local"
UNCDF_USER_PASSWORD="change-this-uncdf-password"
